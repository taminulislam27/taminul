# Copy to .env.local for local development. On Vercel, add these under Project > Settings > Environment Variables.

# Your final domain, no trailing slash. Used for the sitemap, RSS feed and social previews.
# On Vercel you can skip this until you buy a domain: the project's own .vercel.app address is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Overrides the Formspree form ID that is built into src/app/contact/page.tsx.
# Only needed if you ever switch to a different Formspree form.
# On Vercel set its Type to "Config" (not Secret): NEXT_PUBLIC_ values are public by design.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional. A GitHub token with NO scopes raises the API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Optional. The content value of Google Search Console's "HTML tag" verification (see LAUNCH.md).
NEXT_PUBLIC_GOOGLE_VERIFICATION=
