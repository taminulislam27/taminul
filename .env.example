# Copy to .env.local for local development. On Vercel, add these under Project > Settings > Environment Variables.

# Your final domain, no trailing slash. Used for the sitemap, RSS feed and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formspree form ID (the part after /f/ in your form's endpoint, e.g. xyzabcde).
# Leave empty and the contact form opens the visitor's email app instead.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional. A GitHub token with NO scopes raises the API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=
